# Base URL of the real FastAPI backend (app/main.py). Leave unset during
# development to use the built-in mock API layer (src/api/mock/) instead.
VITE_API_BASE_URL=

# Force mocks on/off explicitly. If unset, mocks are used automatically
# whenever VITE_API_BASE_URL is empty.
# VITE_USE_MOCKS=true
